# Server
NODE_ENV=development
PORT=1111
SESSION_SECRET=replace-with-a-long-random-string

# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL (use RDS values when deploying)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=storage

# Optional: shared sessions for multiple servers / restarts
# REDIS_URL=redis://localhost:6379

# Optional: S3 uploads (leave unset to keep local assets/ uploads)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-meme-media-bucket
# AWS_S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com
# Also configure AWS credentials via IAM role or:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
